NODE_ENV=development
PORT=5000

# MongoDB Atlas (use a NEW project, not a personal one)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/digital-heroes

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=7

# Used for CORS in local dev only (in production the client proxies /api, same-origin)
CLIENT_URL=http://localhost:5173


# Razorpay (TEST mode keys: dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Only needed for renewals via webhook (dashboard -> Settings -> Webhooks -> set your own secret)
RAZORPAY_WEBHOOK_SECRET=
# Plans you created in the dashboard: Subscriptions -> Plans
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxx


# Draws
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Generate a long random string.
CRON_SECRET=
# Mode the monthly cron uses when it creates a draw: random or algorithmic
DRAW_DEFAULT_MODE=random


# Cloudinary (winner proof screenshots). Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
