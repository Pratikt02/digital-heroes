{
  "name": "digital-heroes-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "vercel-build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.js",
    "preview:client": "vite preview --config client/vite.config.js",
    "start": "node src/server.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.14",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
